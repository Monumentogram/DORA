  "frozenDesignInvariants": [
    {
      "id": "I2B-INV-01",
      "invariant": "The only runtime root is com.google.crypto.tink:tink-android:1.23.0 in :poc:recovery, with the dependency-local com.google.code.findbugs:jsr305:3.0.2 exclusion and the approved six-runtime/two-test graph."
    },
    {
      "id": "I2B-INV-02",
      "invariant": "Streaming is exactly AES-GCM-HKDF 16/16/SHA256/4096 and AEAD is exactly AES-256-GCM 32/12/16/TINK."
    },
    {
      "id": "I2B-INV-03",
      "invariant": "Generated and parsed handles validate the frozen Parameters before any primitive is created or used through private getPrimary().getKey().getParameters(); Key, Parameters and raw key bytes are never exposed, stored, stringified or logged."
    },
    {
      "id": "I2B-INV-04",
      "invariant": "Every generated keyset is exactly one enabled random-ID primary constructed through the required public KeysetHandle builder sequence."
    },
    {
      "id": "I2B-INV-05",
      "invariant": "TinkConfig.register() and fixed RegistryConfiguration.get() remain private; callers cannot supply a weaker configuration or obtain raw primitives or keyset handles."
    },
    {
      "id": "I2B-INV-06",
      "invariant": "Encrypted keysets use only the nondeprecated four-argument TinkProtoKeysetFormat APIs with exact typed KeyEnvelope AAD."
    },
    {
      "id": "I2B-INV-07",
      "invariant": "The observing Aead proxy retains only its delegate and an enum state, never plaintext or ciphertext references, and production code performs no manual cleartext keyset/proto parsing or SecretKeyAccess."
    },
    {
      "id": "I2B-INV-08",
      "invariant": "Encrypted-keyset parsing has stable typed boundaries for outer invalid, positive authentication rejection, provider operational, unknown, authenticated inner invalid and parsed unsupported suite."
    },
    {
      "id": "I2B-INV-09",
      "invariant": "Neutral decrypt precedence is positive BadPaddingException or AEADBadTagException first, ProviderException second and generic GeneralSecurityException UNKNOWN; successful decrypt and authenticated plaintext-contract failure remain separate, with no REC-I3 outcome."
    },
    {
      "id": "I2B-INV-10",
      "invariant": "Each fresh keyset serializes its encrypted envelope before exactly one encryption; parsed handles are decrypt-only; failed envelope serialization poisons all present and future claimants."
    },
    {
      "id": "I2B-INV-11",
      "invariant": "Strict REC-I1 bindings use exact DORA_RECOVERY_STREAM_AAD_V1_BINARY_BE, microfile, publication and key-envelope codecs with all required cross-binding."
    },
    {
      "id": "I2B-INV-12",
      "invariant": "The stream envelope is generation 1, no unit, range [0,115200000), cadence 0 and zero genesis digest."
    },
    {
      "id": "I2B-INV-13",
      "invariant": "Android Keystore create-new generates once then resolves the exact canonical URI; open-existing only resolves it, with no generation fallback or alias substitution."
    },
    {
      "id": "I2B-INV-14",
      "invariant": "The graph remains 61/61, split 34 policy-covered and 27 explicitly classified tooling configurations; policy-covered JSR305 components and definitions remain zero."
    },
    {
      "id": "I2B-INV-15",
      "invariant": "Release R8 uses exactly three narrow javax.annotation dontwarn rules, no broad dontwarn, retains the crypto boundary and new typed signals, and packages no javax.annotation definitions or native entries."
    },
    {
      "id": "I2B-INV-16",
      "invariant": "Tests assert roundtrip and deterministic invariants but never claim deterministic ciphertext."
    },
    {
      "id": "I2B-INV-17",
      "invariant": "This implementation remains local, unpublished and nonmetric; it includes no device, emulator, network, harness, campaign, REC-I3 activation, PASS, Ready, admission, PR, push or merge."
    }
