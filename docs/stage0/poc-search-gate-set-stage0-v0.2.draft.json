    "storageNormalization": [
      "wal_checkpoint_truncate_success",
      "vacuum",
      "second_wal_checkpoint_truncate_success",
      "close_all_connections",
      "wal_and_shm_absent_or_zero",
      "main_file_bytes_equals_page_count_times_page_size"
