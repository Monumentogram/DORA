    "recoveryReconciliationAlgorithm": [
      {
        "step": 1,
        "condition": "durable run row is absent and an alias and/or key-confirmation temp/final remains after interrupted bootstrap",
        "classification": "INCOMPLETE_KEY_BOOTSTRAP",
        "evidenceRule": "record exact absent, temp-only or final-orphan state as subtype/evidence without changing the classification"
      },
      {
        "step": 2,
        "condition": "durable run row exists but key-confirmation final is absent",
        "classification": "KEY_CONFIRMATION_MISSING"
      },
      {
        "step": 3,
        "condition": "key-confirmation final exists but exact path, type, recorded ciphertext length or recorded ciphertext SHA-256 does not match",
        "classification": "CORRUPT_KEY_CONFIRMATION",
        "decryptAllowed": false
      },
      {
        "step": 4,
        "condition": "exact stored ciphertext identity passed but the Android Keystore alias is absent, invalidated or unusable",
        "classification": "KEY_UNAVAILABLE"
      },
      {
        "step": 5,
        "condition": "all eight effective KEY-04 preconditions hold and Aead.decrypt(existingConfirmationCiphertext, exactAad) terminates with authentication/AAD failure",
        "classification": "KEY_UNAVAILABLE_KEY_MISMATCH",
        "successfulDecryptAllowed": false,
        "postDecryptPlaintextMismatchAllowed": false,
        "replacementKeyAllowed": false
      },
      {
        "step": 6,
        "condition": "decrypt succeeds but bounded plaintext parser, magic, schema, no-trailing-bytes, protocolId, candidateId, runId or canonicalAliasSha256 validation fails",
        "classification": "CORRUPT_KEY_CONFIRMATION",
        "faultRow": "KCF-07",
        "validationPhase": "POST_DECRYPT_ONLY"
      },
      {
        "step": 7,
        "condition": "confirmation is fully valid but a mandatory subsequent key reference or key envelope is absent",
        "classification": "KEY_UNAVAILABLE"
      },
      {
        "step": 8,
        "condition": "subsequent envelope exists but its length, SHA-256, encoding or parser validation fails",
        "classification": "CORRUPT_KEY_ENVELOPE"
      },
      {
        "step": 9,
        "condition": "subsequent envelope is structurally valid but AEAD, AAD or tag verification fails",
        "classification": "KEY_ENVELOPE_AUTH_FAILURE"
      }
    ],
    "plaintextMagicSchemaParserOrTrailingValidationBeforeDecryptAllowed": false,
    "ambiguousExpectedOutcomeAllowed": false
  },
  "reconciliationV06": {
    "NO_DURABLE_ROW_WITH_BOOTSTRAP_REMAINDER": "INCOMPLETE_KEY_BOOTSTRAP; retain exact absent/temp-only/final-orphan subtype and evidence; never infer commit or replace the alias",
    "DURABLE_ROW_MISSING_CONFIRMATION_FINAL": "KEY_CONFIRMATION_MISSING; fail closed and retain evidence",
    "CONFIRMATION_STORED_IDENTITY_MISMATCH": "CORRUPT_KEY_CONFIRMATION before decrypt; path/type/recorded ciphertext length/SHA-256 checks precede decrypt and a failure forbids decrypt",
    "CONFIRMATION_ALIAS_ABSENT_INVALIDATED_OR_UNUSABLE": "KEY_UNAVAILABLE; never generate or replace an alias during recovery",
    "CONFIRMATION_DECRYPT_AUTH_OR_AAD_FAILURE": "KEY_UNAVAILABLE_KEY_MISMATCH only when every effective KEY-04 precondition holds; successful decrypt and post-decrypt plaintext mismatch are forbidden KEY-04 interpretations",
    "CONFIRMATION_DECRYPTED_PLAINTEXT_INVALID": "CORRUPT_KEY_CONFIRMATION through KCF-07; bounded parser, magic, schema, no-trailing-bytes and all exact identity fields are validated only after successful decrypt",
    "VALID_CONFIRMATION_MISSING_LATER_KEY_REFERENCE_OR_ENVELOPE": "KEY_UNAVAILABLE",
    "LATER_ENVELOPE_LENGTH_HASH_ENCODING_OR_PARSER_INVALID": "CORRUPT_KEY_ENVELOPE",
    "STRUCTURALLY_VALID_LATER_ENVELOPE_AUTH_FAILURE": "KEY_ENVELOPE_AUTH_FAILURE",
    "TEMP_OR_FINAL_NAMESPACE_COLLISION_DURING_NEW_RUN": "KEY_REF_COLLISION; never overwrite, promote by name or continue publication"
  },
